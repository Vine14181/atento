# Copie este arquivo para `.env` e preencha com as SUAS chaves.
# O `.env` é ignorado pelo git — nunca commite chaves reais.

# Google Gemini (usada apenas em desenvolvimento local)
# Gere a sua em: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Firebase (Console → Configurações do projeto → Seus apps → Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: email do botão "Suporte / Feedback" (vazio = botão oculto).
# Este aparece no app, então use um endereço que você não se importe em publicar.
VITE_FEEDBACK_EMAIL=

# Nota: a lista de emails VIP NÃO fica aqui. Ela vive só no servidor, na
# variável VIP_EMAILS do painel da hospedagem — se ficasse num VITE_*, os
# endereços iriam para o JavaScript público do site.
